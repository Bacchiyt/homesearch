# Safe configuration selection. Copy to .env only when local overrides are needed.
HOMESEARCH_CONFIG_PATH=config/defaults.toml

# Optional versioned profile and ignored developer-only overrides.
# HOMESEARCH_PROFILE_PATH=config/profiles/example.toml
# HOMESEARCH_LOCAL_CONFIG_PATH=config/local.toml

# Narrow operational overrides.
# HOMESEARCH_LOG_LEVEL=DEBUG
# HOMESEARCH_LOG_FORMAT=console

# Secret values stay outside tracked TOML. Replace locally before selecting the example profile.
# The connection boundary requires postgresql+psycopg://.../<database>.
# HOMESEARCH_DATABASE_URL=replace-with-local-postgresql-url
